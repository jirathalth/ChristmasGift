# PostgreSQL/Neon pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required in production for distributed rate limiting
UPSTASH_REDIS_REST_URL="https://YOUR_DATABASE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"

# E2E safety guard: enable only for an isolated disposable development branch
E2E_ALLOW_DATABASE_MUTATION="false"
E2E_EXPECTED_DATABASE_HOST="YOUR_VERIFIED_DIRECT_NEON_HOST"
